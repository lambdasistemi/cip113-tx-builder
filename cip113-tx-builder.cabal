cabal-version: 3.4
name:          cip113-tx-builder
version:       0.1.1.0
synopsis:      CIP-113 programmable token transaction builders
description:
    Monadic transaction builders for CIP-113 programmable token operations
    (transfer, registry insertion, token minting) built on top of the
    cardano-tx-tools DSL.
license:       Apache-2.0
author:        Paolo Veronelli
maintainer:    paolo.veronelli@gmail.com
category:      Cardano
build-type:    Simple

common opts
    default-language: GHC2021
    ghc-options:      -Wall -Wunused-imports -Wno-unticked-promoted-constructors

    build-depends:
        base < 5

flag werror
    description: Enable -Werror
    manual:      True
    default:     False

common werror
    if flag(werror)
        ghc-options: -Werror

flag build-e2e-tests
    description: Build e2e tests (requires cardano-node at runtime)
    manual:      True
    default:     False

library
    import:          opts, werror
    hs-source-dirs:  src
    exposed-modules:
        Cardano.CIP113.Types
        Cardano.CIP113.Address
        Cardano.CIP113.Transfer
        Cardano.CIP113.Register
        Cardano.CIP113.Registry
        Cardano.CIP113.ThirdParty
        Cardano.CIP113.Deployment
        Cardano.CIP113.Scripts

    build-depends:
        aeson                  >= 2.2  && < 2.3
      , base16-bytestring      >= 1.0  && < 1.1
      , bytestring
      , cardano-crypto-class
      , cardano-ledger-alonzo  >= 1.15 && < 3
      , cardano-ledger-api     >= 1.13 && < 3
      , cardano-ledger-binary  >= 1.8  && < 3
      , cardano-ledger-conway  >= 1.21 && < 3
      , cardano-ledger-core    >= 1.19 && < 3
      , cardano-ledger-mary    >= 1.10 && < 3
      , cardano-node-clients
      , cardano-tx-tools
      , containers
      , microlens              >= 0.4  && < 0.5
      , mtl
      , plutus-core            >= 1.60 && < 3
      , plutus-tx              >= 1.60 && < 3
      , serialise
      , text

executable cip113-cli
    import:          opts, werror
    hs-source-dirs:  exe
    main-is:         Main.hs

    other-modules:
        Cardano.CIP113.CLI.Command.Freeze
        Cardano.CIP113.CLI.Command.Register
        Cardano.CIP113.CLI.Command.Seal
        Cardano.CIP113.CLI.Command.Seize
        Cardano.CIP113.CLI.Command.Sign
        Cardano.CIP113.CLI.Command.Transfer
        Cardano.CIP113.CLI.Provider
        Cardano.CIP113.CLI.Provider.Blockfrost
        Cardano.CIP113.CLI.Provider.Kupo
        Cardano.CIP113.CLI.Provider.Node
        Cardano.CIP113.CLI.Provider.Offline

    build-depends:
        aeson                  >= 2.2  && < 2.3
      , async
      , base16-bytestring
      , bech32
      , bytestring
      , cardano-crypto-class
      , cardano-ledger-api
      , cardano-ledger-binary
      , cardano-ledger-conway
      , cardano-ledger-core
      , cardano-ledger-mary
      , cardano-node-clients
      , cardano-tx-tools
      , cardano-wallet-tools
      , cip113-tx-builder
      , containers
      , directory
      , http-client
      , http-client-tls
      , http-types
      , microlens
      , optparse-applicative   >= 0.18 && < 0.20
      , ouroboros-network:api
      , text

test-suite e2e-tests
    import:           opts

    if !flag(build-e2e-tests)
        buildable: False

    type:             exitcode-stdio-1.0
    hs-source-dirs:   e2e-test
    main-is:          e2e-main.hs
    default-language: GHC2021

    other-modules:
        Cardano.CIP113.E2E.Deploy
        Cardano.CIP113.E2E.DeploymentSpec
        Cardano.CIP113.E2E.RegisterSpec
        Cardano.CIP113.E2E.RegistryResolverSpec
        Cardano.CIP113.E2E.ThirdPartySpec

    build-depends:
        aeson                  >= 2.2  && < 2.3
      , async
      , bytestring
      , cardano-crypto-class
      , cardano-ledger-api       >= 1.13 && < 3
      , cardano-ledger-conway    >= 1.21 && < 3
      , cardano-ledger-core      >= 1.19 && < 3
      , cardano-ledger-mary      >= 1.10 && < 3
      , cardano-node-clients
      , cardano-node-clients:devnet
      , cardano-tx-tools
      , cip113-tx-builder
      , containers
      , hspec                    >= 2.11 && < 2.12
      , microlens                >= 0.4  && < 0.5
      , plutus-core              >= 1.60 && < 3
      , plutus-tx                >= 1.60 && < 3
      , text
